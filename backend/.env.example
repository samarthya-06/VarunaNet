PORT=3000
DATABASE_URL=postgres://username:password@localhost:5432/varunanet_db

# REQUIRED: Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=

# Optional: Token expiration time
JWT_EXPIRES_IN=7d

# Optional: Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Optional: Rate limiting (requests per 15 minutes)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_AUTH_MAX=10

# Optional: Sentry DSN for error monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Optional: Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Environment
NODE_ENV=development

# Optional admin login (disabled until a password is configured)
ADMIN_EMAIL=admin@varunanet.local
ADMIN_PASSWORD=
